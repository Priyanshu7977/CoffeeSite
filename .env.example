# ========================================================
# NOIR ROAST — PAYMENT & BACKEND CONFIGURATION
# Copy this file to .env and configure with your credentials.
# NEVER commit the real .env file with secrets to GitHub.
# ========================================================

# Razorpay Test / Live API Keys (Used on the Backend)
# For testing: Obtain test keys from https://dashboard.razorpay.com/#/access/api_keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# Razorpay Webhook Secret (Configured in Razorpay Dashboard > Webhooks)
# Set URL to: https://your-domain.vercel.app/api/payment/webhook
# Subscribe to: payment.authorized, payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Cryptographic Session & Rate Limit Secret (Min 32 characters random string)
SESSION_SECRET=noir_roast_secure_session_secret_2026_change_in_production

# Backend Server Port (Local Node.js/Express dev server)
PORT=5000

# Client-facing Razorpay Key ID (Public Key ID only; NEVER expose the Secret!)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# API Base URL (leave empty for same-origin proxy in development & Vercel serverless)
VITE_API_BASE_URL=

# ========================================================
# FIREBASE AUTHENTICATION & FIRESTORE CONFIGURATION
# (Obtain from Firebase Console > Project Settings > General > Your Apps)
# Enable Email/Password, Google OAuth, and Phone Auth under Firebase Authentication.
# ========================================================
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id
